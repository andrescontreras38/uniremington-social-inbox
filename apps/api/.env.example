# Configuracion de la Bandeja Uniremington
# Copie este archivo a .env y complete los valores. NUNCA suba .env al repositorio.

NODE_ENV=development
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info

# Base de datos: PostgreSQL, igual en desarrollo que en produccion (lo exige
# el despliegue serverless en Vercel). Recomendado: un proyecto gratuito en
# Neon (neon.tech) con una rama "dev" y otra "prod" bajo el mismo proyecto,
# asi local y produccion usan el mismo motor sin instalar Postgres a mano.
# Si Neon (u otro proveedor con pooling) va detras de Vercel, use la cadena
# "pooled" que ellos entregan, no la directa: cada invocacion serverless abre
# su propia conexion y sin pooling se agotan rapido.
DATABASE_URL="postgresql://usuario:clave@ep-ejemplo.neon.tech/uniremington?sslmode=require"

# Origenes
WEB_ORIGIN=http://localhost:5273
PUBLIC_API_URL=http://localhost:3000

# Clave maestra AES-256-GCM (32 bytes en base64). Genere una propia con:
#   openssl rand -base64 32
ENCRYPTION_KEY=REEMPLACE_CON_32_BYTES_EN_BASE64

# Sesiones
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Proveedor de redes: mock (desarrollo) o meta (produccion)
SOCIAL_PROVIDER=mock

# Credenciales de Meta (obligatorias con SOCIAL_PROVIDER=meta)
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0

# Claude
ANTHROPIC_API_KEY=
AI_ENABLED=false
# Modelos por tarea. Haiku 4.5 es el mas economico (1 y 5 USD por millon de
# tokens). Si los borradores quedan cortos de calidad, suba SOLO el de
# redaccion a claude-sonnet-5 y deje la clasificacion en Haiku.
AI_MODEL_CLASSIFY=claude-haiku-4-5
AI_MODEL_DRAFT=claude-haiku-4-5
# Solo se aplican a modelos que admiten esfuerzo; Haiku 4.5 los ignora.
AI_CLASSIFY_EFFORT=low
AI_DRAFT_EFFORT=low
# Reutilizar la clasificacion de un comentario identico visto en N dias.
AI_CLASSIFY_REUSE_DAYS=30

# Alertas por correo
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM=bandeja@uniremington.edu.co
ALERT_RECIPIENTS=
NEGATIVE_SPIKE_THRESHOLD=3
NEGATIVE_SPIKE_WINDOW_MINUTES=60

# Retencion de datos personales en dias (Ley 1581 de 2012). 0 = sin purga
DATA_RETENTION_DAYS=730

# Limites y trabajos programados
RATE_LIMIT_MAX=300
# En un servidor persistente (VPS): true, el propio proceso sincroniza cada
# SYNC_INTERVAL_MINUTES. En Vercel: false, y CRON_SECRET pasa a ser
# obligatorio porque Vercel Cron dispara /api/internal/sync por HTTP en su
# lugar (ver vercel.json).
ENABLE_JOBS=true
SYNC_INTERVAL_MINUTES=5
# CRON_SECRET=genere-uno-largo-y-aleatorio-si-ENABLE_JOBS-es-false

# Carga inicial (opcional; si se omite se genera una contrasena al azar)
SEED_ADMIN_EMAIL=admin@uniremington.edu.co
SEED_ADMIN_PASSWORD=
